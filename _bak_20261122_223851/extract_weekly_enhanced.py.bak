# Read QJ (秋季特惠 65款) / MX (明星同款 7款) / XC (新客主推 5款) SKUs
# 2026-09-19/21 用户新增周月分析模块
def _load_sku_set(pattern_keyword, label):
    """按 glob 模式加载 SKU xlsx 并返回 set（按修改时间最新）"""
    import glob as _g
    paths = sorted(_g.glob(
        f'/Users/a123/Library/Containers/com.tencent.WeWorkMac/Data/Documents/Profiles/*/Caches/Files/2026-*/*/{pattern_keyword}'
    ), key=os.path.getmtime)
    if not paths:
        return set()
    df = pd.read_excel(paths[-1])
    col = '乐高编号' if '乐高编号' in df.columns else '产品编号'
    skus = set(df[col].apply(lambda x: str(int(x)) if pd.notna(x) else '').tolist())
    print(f"   {label}: {os.path.basename(paths[-1])} {len(skus)}款")
    return skus

qj_skus = _load_sku_set('秋季特惠sku明细.xlsx', '秋季特惠SKU')
mx_skus = _load_sku_set('明星同款sku明细.xlsx', '明星同款SKU')
xc_skus = _load_sku_set('新客主推款sku明细.xlsx', '新客主推SKU')

def get_match_names(gname):
    """Get all possible name matches for a guide（用户 2026-09-02 16:34 定案）"""
    match_names = [gname, f'长期兼职-{gname}']
    if gname == '李婷1':
        match_names += ['扬万支援销售', '扬州万象汇支援销售']
    if gname == '黄小莉1':
        match_names += ['泰州万象城-支援2', '泰州万象城支援2']
    return match_names

def calc_guide_weekly(wk_df, gname, info, wos_map):
    """Calculate guide weekly metrics from a filtered dataframe"""
    store = info['store']
    match_names = get_match_names(gname)
    g_wk = wk_df[(wk_df['门店名'] == store) & (wk_df['导购姓名'].astype(str).str.strip().isin(match_names))]

    if len(g_wk) == 0:
        return {
            'wk_sales': 0, 'wk_qty': 0, 'wk_cnt': 0,
            'wk_atv': 0, 'wk_jd': 0, 'wk_wos': 0, 'wk_lt': 0, 'wk_lt_qty': 0,
            'wk_qj': 0, 'wk_qj_qty': 0, 'wk_mx': 0, 'wk_mx_qty': 0, 'wk_xc': 0, 'wk_xc_qty': 0,
            'wk_np': 0,
        }

    pos = g_wk[g_wk['结算金额'] > 0]
    wk_sales = g_wk['结算金额'].sum()
    wk_qty = int(pos['数量'].sum()) if len(pos) > 0 else 0
    wk_cnt = pos['单号'].nunique() if len(pos) > 0 else 0
    wk_atv = round(wk_sales / wk_cnt, 2) if wk_cnt > 0 else 0
    wk_jd = round(wk_qty / wk_cnt, 2) if wk_cnt > 0 else 0
    # WOS（备注补充归因：导购姓名空 → 取订单备注 [SA_NAME]）
    wk_wos = wos_attr.wos_lookup(wos_map, store, gname)
    g_lt = g_wk[g_wk['乐高编号_str'].isin(lt_skus)]
    wk_lt = g_lt['结算金额'].sum()
    wk_lt_qty = int(g_lt[g_lt['结算金额'] > 0]['数量'].sum()) if len(g_lt[g_lt['结算金额'] > 0]) > 0 else 0
    # 秋季特惠 65款 (2026-09-19 新增)
    g_qj = g_wk[g_wk['乐高编号_str'].isin(qj_skus)]
    wk_qj = g_qj['结算金额'].sum()
    wk_qj_qty = int(g_qj[g_qj['结算金额'] > 0]['数量'].sum()) if len(g_qj[g_qj['结算金额'] > 0]) > 0 else 0
    # 明星同款 7款 (2026-09-21 新增)
    g_mx = g_wk[g_wk['乐高编号_str'].isin(mx_skus)]
    wk_mx = g_mx['结算金额'].sum()
    wk_mx_qty = int(g_mx[g_mx['结算金额'] > 0]['数量'].sum()) if len(g_mx[g_mx['结算金额'] > 0]) > 0 else 0
    # 新客主推款 5款 (2026-09-19 新增)
    g_xc = g_wk[g_wk['乐高编号_str'].isin(xc_skus)]
    wk_xc = g_xc['结算金额'].sum()
    wk_xc_qty = int(g_xc[g_xc['结算金额'] > 0]['数量'].sum()) if len(g_xc[g_xc['结算金额'] > 0]) > 0 else 0
    # 新品（2026-11-01 起：上市日期年/月 == 报告年/月，即报告月上市的产品）
    np_mask = ((g_wk['上市日期_dt'].dt.year == max_date.year)
               & (g_wk['上市日期_dt'].dt.month == max_date.month))
    wk_np = g_wk[np_mask]['结算金额'].sum()
    return {
        'wk_sales': round(wk_sales, 2),
        'wk_qty': wk_qty,
        'wk_cnt': wk_cnt,
        'wk_atv': wk_atv,
        'wk_jd': wk_jd,
        'wk_wos': round(wk_wos, 2),
        'wk_lt': round(wk_lt, 2),
        'wk_lt_qty': wk_lt_qty,
        # ⚠️ 2026-10-13 用户定：秋季特惠活动已结束，wk_qj 字段不再输出（数据层 g_qj 计算保留备回退）
        'wk_mx': round(wk_mx, 2),
        'wk_mx_qty': wk_mx_qty,
        'wk_xc': round(wk_xc, 2),
        'wk_xc_qty': wk_xc_qty,
        'wk_np': round(wk_np, 2),
    }

guide_weekly = {}

# WOS 导购归因（含订单备注 [SA_NAME] 补充归因）—— 与导购WOS重算报表口径一致
wk29_wos_map = wos_attr.build_wos_map(
    wk29_df, store_col='门店名', guide_col='导购姓名', note_col='备注',
    amt_col='结算金额', wos_col='支付方式名称', normalizer=normalize_guide_name)
wk28_wos_map = wos_attr.build_wos_map(
    wk28_df, store_col='门店名', guide_col='导购姓名', note_col='备注',
    amt_col='结算金额', wos_col='支付方式名称', normalizer=normalize_guide_name)

for gname, info in guide_info.items():
    wk29_data = calc_guide_weekly(wk29_df, gname, info, wk29_wos_map)
    wk28_data = calc_guide_weekly(wk28_df, gname, info, wk28_wos_map)
    
    wk_rate = round(wk29_data['wk_sales'] / info['target'] * 100, 1) if info['target'] > 0 else 0
    wk28_sales = wk28_data['wk_sales']
    wow = round((wk29_data['wk_sales'] - wk28_sales) / wk28_sales * 100, 1) if wk28_sales > 0 else None

    guide_weekly[gname] = {
        'name': gname, 'store': info['store'], 'title': info['title'],
        'target': info['target'],
        'wk_sales': wk29_data['wk_sales'],
        'wk_qty': wk29_data['wk_qty'],
        'wk_cnt': wk29_data['wk_cnt'],
        'wk_atv': wk29_data['wk_atv'],
        'wk_jd': wk29_data['wk_jd'],
        'wk_wos': wk29_data['wk_wos'],
        'wk_lt': wk29_data['wk_lt'],
        'wk_lt_qty': wk29_data['wk_lt_qty'],
        # ⚠️ 2026-10-13 用户定：秋季特惠活动已结束，wk_qj 字段不再输出
        'wk_mx': wk29_data['wk_mx'],
        'wk_mx_qty': wk29_data['wk_mx_qty'],
        'wk_xc': wk29_data['wk_xc'],
        'wk_xc_qty': wk29_data['wk_xc_qty'],
        'wk_np': wk29_data['wk_np'],
        'wk_rate': wk_rate,
        'wk28_sales': round(wk28_sales, 2),
        'wow': wow,
    }
    wow_str = f"{wow:+.1f}%" if wow is not None else 'N/A'
    print(f"   {gname} ({info['store']}): 本周=¥{wk29_data['wk_sales']:,.0f} | 上周=¥{wk28_sales:,.0f} | 环比{wow_str}")

# 按门店分组
