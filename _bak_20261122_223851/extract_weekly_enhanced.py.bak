print("\n4.8 计算门店月成交率（笔数/客流，月累计）...")
# ⚠️ 月成交率分母 = 用户每月提供的全月累计客流文件(含7店|门店/客流两列)。
#    该文件已是全月累计(含本周WK), 直接采用, 不再叠加周客流(否则WK被重复计算)。
#    文件名按"M月客流.xlsx"惯例, 每月初更新。
# 月客流文件按「报告月」动态查找（原写死 8月客流截止17日.xlsx，换月即失效）
# 与 extract_monthly.py 同逻辑：搜 Desktop/Desktop/。/{M}月/Downloads/项目目录，排除含「周」的文件
import re as _re


def _find_flow_file(month):
    _dirs = ['/Users/a123/Desktop', '/Users/a123/Desktop/。', f'/Users/a123/Desktop/。/{month}月',
             '/Users/a123/Downloads', os.path.dirname(os.path.abspath(__file__))]
    _exact, _fuzzy, _plain = [], [], []
    for _d in _dirs:
        if not os.path.isdir(_d):
            continue
        for _p in glob.glob(os.path.join(_d, '*客流*.xlsx')):
            _b = os.path.basename(_p)
            if _b.startswith('~$') or '周' in _b:
                continue
            if _re.match(rf'^{month}月客流', _b):
                _exact.append(_p)
            elif _re.search(rf'{month}月', _b):
                _fuzzy.append(_p)
            elif _b == '月客流.xlsx':  # 2026-09-13：用户改用无月份前缀的「月客流.xlsx」
                _plain.append(_p)
    return _exact[0] if _exact else (_fuzzy[0] if _fuzzy else (_plain[0] if _plain else None))


FLOW_MONTH_FILE = _find_flow_file(max_date.month)
FLOW_WK_FILE = None  # 已废弃: 历史逻辑=早期累计+本周客流拼接; 现改为单份全月文件, 不再使用
FLOW_MAP = {
    '扬州万象汇新店': '扬州万象汇', '扬州京华城': '扬州京华城', '扬州江都金鹰': '扬州江都金鹰',
    '泰州万象城': '泰州万象城', '宿迁宝龙': '宿迁宝龙', '淮安新亚广场': '淮安新亚',
    '淮安万象城': '淮安万象城'
}
# 2026-11-01：客流后台导出的店名是编码格式（如「LCS0632-LW～泰州万象城乐高」），
# 精确匹配全部落空 → 7 店成交率全空。补两级兜底（与 extract_monthly.py 同思路）：
#   ① LCS 编码前缀匹配（编码带前导零时先 lstrip('0')）
#   ② 店名子串匹配（长名优先，避免「扬州万象汇」抢占「扬州万象汇新店」）
FLOW_CODE_MAP = {
    '133': '扬州万象汇', '275': '扬州京华城', '364': '扬州江都金鹰',
    '632': '泰州万象城', '249': '宿迁宝龙', '305': '淮安新亚', '420': '淮安万象城',
}
_FLOW_KEYS_BY_LEN = sorted(FLOW_MAP.keys(), key=len, reverse=True)


def _match_flow_store(sn, flow_map):
    """客流文件店名 → 标准门店名（精确 → 编码 → 子串）"""
    _sn = str(sn).strip()
    std = flow_map.get(_sn)
    if std:
        return std
    _code = _re.match(r'LCS(\d+)', _sn, _re.I)
    if _code:
        _c = _code.group(1).lstrip('0') or '0'
        if _c in FLOW_CODE_MAP:
            return FLOW_CODE_MAP[_c]
    for _k in _FLOW_KEYS_BY_LEN:
        if _k in _sn:
            return flow_map[_k]
    return None


REPORT_MONTH_WK = max_date.month
# 2026-11-02：按报告月匹配员工指标文件（不按 mtime 取最新）
import guide_filter as _gf_pick
GUIDE_XLSX = _gf_pick.pick_guide_xlsx(_cands, REPORT_MONTH_WK)
# ⚠️必须含年份过滤：本脚本glob了Downloads全部CSV(含2025年No.233906)，仅按month过滤会把去年同月混入当月累计
cur_month_df = all_df[(all_df['销售日期_dt'].dt.year == max_date.year) & (all_df['销售日期_dt'].dt.month == REPORT_MONTH_WK)]
flow_map = {}
if not FLOW_MONTH_FILE:
    print(f"   ⚠️ 未找到 {max_date.month}月客流文件（期望「{max_date.month}月客流.xlsx」），月成交率留空")
try:
    # 月客流.xlsx: 有表头(门店|客流)，全月累计客流(月初起~截止上周末, 已含本周WK)
    # ⚠️ 该文件已是全月累计, 直接作为月成交率分母, 不再叠加周客流(避免WK重复计算)
    month_raw = pd.read_excel(FLOW_MONTH_FILE, sheet_name='Sheet1', header=0)
    month_raw = month_raw.rename(columns={month_raw.columns[0]: 'flow_store', month_raw.columns[1]: '客流'})
    month_raw['门店名'] = month_raw['flow_store'].map(lambda s: _match_flow_store(s, FLOW_MAP))
    month_flow_map = month_raw.dropna(subset=['门店名']).set_index('门店名')['客流'].to_dict()
    flow_map = {s: int(month_flow_map.get(s, 0)) for s in STORE_ORDER}
    print(f"   月客流(全月累计)读取: 合计 {int(sum(month_flow_map.values()))} 人次, 覆盖 {len(month_flow_map)} 家店")
    print(f"   月累计客流(直接采用全月文件): 合计 {int(sum(flow_map.values()))} 人次")
    missing = [s for s in STORE_ORDER if flow_map.get(s, 0) == 0]
    if missing:
        print(f"   ⚠️ 以下门店客流无数据→月成交率显示'缺客流': {missing}")
except Exception as e:
    print(f"   ⚠️ 客流文件读取失败: {e}")
    flow_map = {}
print(f"   月客流合计: {int(sum(flow_map.values()))} 人次")
conversion = {}
for s in STORE_ORDER:
    s_m = cur_month_df[cur_month_df['门店名'] == s]
    pos = s_m[s_m['结算金额'] > 0]
    cnt = pos['单号'].nunique() if len(pos) > 0 else 0
    fl = flow_map.get(s, 0)
    rate = round(cnt / fl * 100, 2) if fl > 0 else None  # 月客流缺失时置None，页面显示"缺客流"而非误导的0%
    conversion[s] = {'flow': int(fl), 'cnt': int(cnt), 'rate': rate}
rf = sum(conversion[s]['flow'] for s in STORE_ORDER)
rc = sum(conversion[s]['cnt'] for s in STORE_ORDER)
conversion['_region'] = {'flow': int(rf), 'cnt': int(rc), 'rate': round(rc / rf * 100, 2) if rf > 0 else None}  # 缺客流→None(页面显示"缺客流")，不能给0%误导
print("   门店月成交率: " + " | ".join(f"{s} {conversion[s]['rate']}%" for s in STORE_ORDER) + f" | 区域 {conversion['_region']['rate']}%")

