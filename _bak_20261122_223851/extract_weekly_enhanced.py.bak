    '淮安万象城': '淮安万象城'
}
# 当周实际天数（保留变量，9月客流口径下不再使用，但保留便于未来动态窗口）
_wk_days = (max_date_eod - WK_START).days + 1
wk_flow_df = all_df[(all_df['销售日期_dt'] >= WK_START) & (all_df['销售日期_dt'] <= max_date_eod)]
try:
    # 新文件 schema: Sheet1 列0='门店' / 列1='客流'（用户口径：WK36整周累计客流，不乘天数）
    wk_flow_raw = pd.read_excel(WK_FLOW_FILE, sheet_name='Sheet1', header=0)
    col0, col1 = wk_flow_raw.columns[0], wk_flow_raw.columns[1]
    wk_flow_map = {}
    for _, r in wk_flow_raw.iterrows():
        sn = r.get(col0); val = r.get(col1)
        if pd.isna(sn) or pd.isna(val) or float(val) == 0: continue
        std = _match_flow_store(sn, FLOW_MAP_WK)
        if not std: continue
        # 2026-09-07：用户口径，WK36客流 = WK36整周累计，不乘天数
        wk_flow_map[std] = float(val)
    print(f"   WK{WK_NUM_INT}客流文件读取(Sheet1): 苏中7店WK{WK_NUM_INT}累计合计 {int(sum(wk_flow_map.values()))} 人次")
except Exception as e:
    print(f"   ⚠️ WK{WK_NUM_INT}客流文件读取失败: {e}")
    wk_flow_map = {}
weekly_conversion = {}
for s in STORE_ORDER:
    s_w = wk_flow_df[wk_flow_df['门店名'] == s]
    pos = s_w[s_w['结算金额'] > 0]
    cnt = pos['单号'].nunique() if len(pos) > 0 else 0
    fl = wk_flow_map.get(s, 0)
    rate = round(cnt / fl * 100, 2) if fl > 0 else None  # 客流缺失时置None，页面显示"缺客流"而非误导的0%
    weekly_conversion[s] = {'flow': int(fl), 'cnt': int(cnt), 'rate': rate}
rf = sum(weekly_conversion[s]['flow'] for s in STORE_ORDER)
rc = sum(weekly_conversion[s]['cnt'] for s in STORE_ORDER)
weekly_conversion['_region'] = {'flow': int(rf), 'cnt': int(rc), 'rate': round(rc / rf * 100, 2) if rf > 0 else None}
print("   WK%d门店周成交率: " % WK_NUM_INT + " | ".join(f"{s} {weekly_conversion[s]['rate']}%" for s in STORE_ORDER) + f" | 区域 {weekly_conversion['_region']['rate']}%")

# ============================================================
# 5. 更新 weekly_analysis.json
# ============================================================
print("\n5. 更新 weekly_analysis.json...")
with open(OUTPUT_JSON, 'r', encoding='utf-8') as f:
    weekly = json.load(f)

# 更新门店周环比和WK28 + 每日同比/完成率
for store in STORE_ORDER:
    if store in weekly:
        weekly[store]['wk28_amt'] = store_wk28.get(store, 0)
        weekly[store]['wk_np_amt'] = np_store.get(store, 0)
        weekly[store]['wk_yoy_amt'] = store_wk_yoy.get(store, 0)  # 2026-09-28：去年同期WK累计
        wow = round((store_wk29[store] - store_wk28[store]) / store_wk28[store] * 100, 1) if store_wk28.get(store, 0) > 0 else None
        weekly[store]['wow'] = wow
        wk_yoy = round((store_wk29[store] - store_wk_yoy.get(store, 0)) / store_wk_yoy.get(store, 0) * 100, 1) if store_wk_yoy.get(store, 0) > 0 else None
        weekly[store]['wk_yoy'] = wk_yoy
        # 更新daily数组 — 添加target/rate/yoy_amt/yoy_pct
        daily_arr = weekly[store].get('daily', [])
        s_td = store_daily_target.get(store, {})
        s_yd = store_daily_yoy.get(store, {})
        for d_entry in daily_arr:
            # date="7/27" -> month=7, day=27；按实际月份到对应指标同期表取数（修复跨月错位）
            parts = d_entry['date'].split('/')
            mth = int(parts[0]); day = int(parts[1])
            t = s_td.get((mth, day), 0)
            y = s_yd.get((mth, day), 0)
            d_entry['target'] = round(t, 2)
            d_entry['rate'] = round(d_entry['total'] / t * 100, 1) if t > 0 else 0
            d_entry['yoy_amt'] = round(y, 2)
            d_entry['yoy_pct'] = round((d_entry['total'] - y) / y * 100, 1) if y > 0 else None
            # 长尾款自 2026-10-10 起仅统计销售额，不计算目标/完成率
        # 周长尾款口径变更（2026-10-10 起仅销售额，无指标）
        # 周秋特/明星同款/新客主推款销售按日累计（2026-09-19/21 用户新增）
        # ⚠️ bugfix：原代码仅在 line 437 写到了导购字典，门店字典从未赋值，导致 wk_qj_amt/wk_mx_amt/wk_xc_amt 全部为 0
        # 修复：直接在门店层级按 WK 窗口 + SKU 集合求和
        _s_wk = wk29_df[wk29_df['门店名'] == store]
        # ⚠️ 2026-10-13 用户定：秋季特惠活动已结束，wk_qj / wk_qj_amt 不再输出
        weekly[store]['wk_mx'] = round(_s_wk[_s_wk['乐高编号_str'].isin(mx_skus)]['结算金额'].sum(), 2)
        weekly[store]['wk_xc'] = round(_s_wk[_s_wk['乐高编号_str'].isin(xc_skus)]['结算金额'].sum(), 2)
        weekly[store]['wk_mx_amt'] = float(weekly[store]['wk_mx'])
        weekly[store]['wk_xc_amt'] = float(weekly[store]['wk_xc'])

# 构建区域daily数组
# ⚠️ 跨月周(WK36=8/31-9/6)踩坑：原逻辑拿第一家店的 daily 当模板逐日找同名条目，
#    某店某天没销售时该条目不存在 → 列表索引越界直接崩，整页空白。
#    改为：日期取全部门店并集 + 缺日按 0 计（安全取值），既不会崩也不会丢天。
def _day_val(store, date, key, default=0):
    for e in weekly.get(store, {}).get('daily', []):
        if e['date'] == date:
            return e.get(key, default)
    return default


_all_dates, _wd_map = [], {}
for s in STORE_ORDER:
    for e in weekly.get(s, {}).get('daily', []):
        if e['date'] not in _all_dates:
            _all_dates.append(e['date'])
        _wd_map.setdefault(e['date'], e.get('weekday', ''))
_all_dates.sort(key=lambda d: (int(d.split('/')[0]), int(d.split('/')[1])))

region_daily = []
for d in _all_dates:
    parts = d.split('/')
    mth = int(parts[0]); day = int(parts[1])
    t = region_daily_target.get((mth, day), 0)
    y = region_daily_yoy.get((mth, day), 0)
    # 汇总所有门店当天数据（缺日按0）
    r_total = sum(_day_val(s, d, 'total') for s in STORE_ORDER if s in weekly)
    r_lt = sum(_day_val(s, d, 'lt') for s in STORE_ORDER if s in weekly)
    r_wos = sum(_day_val(s, d, 'wos') for s in STORE_ORDER if s in weekly)
    r_jl = sum(_day_val(s, d, 'jl') for s in STORE_ORDER if s in weekly)
    r_tx = sum(_day_val(s, d, 'tx_cnt') for s in STORE_ORDER if s in weekly)
    # 2026-10-01 调整：淮安万象城 2025-09-17 开业，但 10 月起的周窗口落在开业后；
    # 全口径纳入淮万（不排除），让 yoy 分子分母口径一致
    r_total_for_yoy = sum(_day_val(s, d, 'total') for s in STORE_ORDER if s in weekly)
    region_daily.append({
        'date': d,
        'weekday': _wd_map.get(d, ''),
        'total': round(r_total, 2),
        'lt': round(r_lt, 2),
        'wos': round(r_wos, 2),
        'jl': round(r_jl, 2),
        'tx_cnt': r_tx,
        'target': round(t, 2),
        'rate': round(r_total / t * 100, 1) if t > 0 else 0,
        'yoy_amt': round(y, 2),
        'yoy_pct': round((r_total_for_yoy - y) / y * 100, 1) if y > 0 else None,
    })

# 更新产品系列结构
weekly['_series'] = series_by_store
series_by_store['_region'] = region_series

# 更新产品名称TOP10(含件数)
weekly['_products'] = products_by_store

# 更新导购数据
weekly['_guides'] = guide_by_store

# 更新样品销售数据（2026-09-23 修复：周分析前未定义 sample_data/sample_region）
# 样品仓订单（"下单店仓名称"含"样品"）按当前周WK窗口聚合
sample_data = {}
for store in STORE_ORDER:
    s_wk = sample_df[(sample_df['门店名'] == store) & (sample_df['销售日期_dt'] >= WK_START) & (sample_df['销售日期_dt'] <= max_date_eod)]
    s_wk_pos = s_wk[s_wk['结算金额'] > 0]
    sample_data[store] = {
        'wk_amt': round(float(s_wk['结算金额'].sum()), 2),
        'wk_qty': int(s_wk_pos['数量'].sum()) if len(s_wk_pos) > 0 else 0,
    }
sample_region = {
    'wk_amt': round(sum(v['wk_amt'] for v in sample_data.values()), 2),
    'wk_qty': sum(v['wk_qty'] for v in sample_data.values()),
}
print(f"   区域: WK样品¥{sample_region['wk_amt']}({sample_region['wk_qty']}件)")

weekly['_sample'] = sample_data
weekly['_sample_region'] = sample_region
weekly['_region']['wk_np_amt'] = np_region

# 新增：当月新品列表
weekly['_new_products'] = new_products

# 新增：门店月成交率（笔数/客流）
weekly['_conversion'] = conversion

# 新增：门店WK周成交率（笔数/客流，窗口跟随报告周动态）
weekly['_weekly_conversion'] = weekly_conversion

# 更新区域数据
if '_region' in weekly:
    weekly['_region']['wk28_amt'] = region_wk28
    weekly['_region']['wk_amt'] = region_wk29
    weekly['_region']['wow'] = region_wow
    weekly['_region']['wk_yoy_amt'] = region_wk_yoy  # 2026-09-28：去年同期WK累计
    weekly['_region']['wk_yoy'] = region_yoy
    weekly['_region']['daily'] = region_daily
    weekly['_region']['wk_atv'] = round(region_wk29 / max(sum(d['tx_cnt'] for d in region_daily), 1), 2)
    # 区域周长尾款：原始 weekly JSON 的 _region 没有 wk_lt，需按门店汇总补齐
    _r_wk_lt = sum(weekly[s].get('wk_lt', 0) for s in STORE_ORDER if s in weekly)
    weekly['_region']['wk_lt'] = round(_r_wk_lt, 2)
    weekly['_region']['wk_lt_qty'] = int(sum(weekly[s].get('wk_lt_qty', 0) for s in STORE_ORDER if s in weekly))
    # 长尾款自 2026-10-10 起仅统计销售额，无目标/完成率
    print(f"   区域周长尾款: ¥{_r_wk_lt:,.0f}")

    # 区域周明星同款/新客主推款销售汇总（2026-09-19/21 用户新增）
    # ⚠️ 2026-10-13 用户定：秋季特惠活动已结束，wk_qj_amt 不再输出（数据层计算保留备回退）
    weekly['_region']['wk_mx_amt'] = round(sum(weekly[s].get('wk_mx_amt', 0) for s in STORE_ORDER if s in weekly), 2)
    weekly['_region']['wk_xc_amt'] = round(sum(weekly[s].get('wk_xc_amt', 0) for s in STORE_ORDER if s in weekly), 2)

# 口径可追溯：新品口径（长尾款指标自 2026-10-10 起已停用）
weekly['_meta'] = {
    'wk_num': WK_NUM_INT,
    'wk_start': WK_START.strftime('%Y-%m-%d'),
    'max_date': max_date.strftime('%Y-%m-%d'),
    'new_product_since': NEW_PRODUCT_SINCE.strftime('%Y-%m-%d'),
    'store_order': STORE_ORDER,
}

with open(OUTPUT_JSON, 'w', encoding='utf-8') as f:
    json.dump(weekly, f, ensure_ascii=False, indent=2)

print(f"\n✅ 完成!")
print(f"   门店数: {len(STORE_ORDER)} | 导购数: {len(guide_weekly)} | 系列数: {len(region_series)}")
print(f"   数据已写入: {OUTPUT_JSON}")
