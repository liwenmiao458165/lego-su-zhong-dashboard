#!/usr/bin/env node
/**
 * runtime_check.js — 周月分析页面「执行期」校验
 *
 * 背景（2026-09-04）：区域对比 Tab 全空白。
 * 根因是 renderComparison() 里用了 TDZ 变量（const 声明在使用之后），
 * 这类错误 `new Function(code)` 的语法检查**查不出来**——语法完全合法，
 * 只有真正执行到那一行才会抛 ReferenceError。
 *
 * 所以本脚本在 Node 的 vm 沙箱里真正跑一遍渲染函数，抓运行期异常：
 *   - TDZ / ReferenceError（const 未初始化就被用）
 *   - null.toFixed / undefined.xxx
 *   - 渲染后 content 区域过短（< 200 字符，说明整块没渲染出来）
 *
 * 用法：
 *   node runtime_check.js                          # 校验默认两个文件
 *   node runtime_check.js path/a.html path/b.html  # 校验指定文件
 * 退出码：0 = 通过；1 = 有运行期错误（流水线应阻断部署）
 *
 * ⚠️ 维护注意：这是**独立文件**，不要改成由 Python 拼字符串生成。
 *    之前那版用 Python 三引号拼 JS 模板字符串，forEach 的 `});` 被包进
 *    模板字面量导致结构错乱，排查成本极高。
 */

const fs = require('fs');
const vm = require('vm');

const DEFAULT_FILES = [
  '/Users/a123/WorkBuddy/Claw/outputs/weekly_analysis.html',
  '/Users/a123/WorkBuddy/Claw/outputs/monthly_analysis.html'
];

const args = process.argv.slice(2);
const FILES = (args.length ? args : DEFAULT_FILES).map(p => [p, p.split('/').pop()]);

const STORES = ['扬州万象汇', '扬州京华城', '扬州江都金鹰', '泰州万象城', '宿迁宝龙', '淮安新亚', '淮安万象城'];
const REGION_TAB = '区域对比';
const MIN_CONTENT_LEN = 200;

// ---------- Canvas 2D 桩 ----------
function make2d() {
  const noop = () => {};
  return new Proxy({}, {
    get(t, k) {
      if (typeof k === 'symbol') return undefined;
      if (k === 'canvas') return { width: 600, height: 400 };
      if (k === 'measureText') return () => ({ width: 10 });
      if (k === 'createLinearGradient' || k === 'createRadialGradient') return () => ({ addColorStop: noop });
      if (k === 'getImageData') return () => ({ data: [] });
      return noop;
    },
    set() { return true; }
  });
}

// ---------- DOM 桩 ----------
function makeElement(id) {
  const el = {
    id: id || '',
    innerHTML: '', outerHTML: '', textContent: '', value: '',
    style: {}, dataset: {}, children: [], childNodes: [],
    width: 600, height: 400,
    classList: { toggle() {}, add() {}, remove() {}, contains() { return false; } },
    appendChild(c) {
      this.children.push(c);
      if (c && typeof c === 'object' && typeof c._html === 'string') this.innerHTML += c._html;
      return c;
    },
    insertBefore(c) { return this.appendChild(c); },
    removeChild() {}, remove() {}, setAttribute() {}, getAttribute() { return null; },
    addEventListener() {}, removeEventListener() {},
    getContext() { return make2d(); },
    getBoundingClientRect() { return { width: 600, height: 400, top: 0, left: 0, right: 600, bottom: 400 }; },
    querySelectorAll() { return []; },
    querySelector() { return makeElement(); },
    focus() {}, click() {}, blur() {},
    insertAdjacentHTML(pos, html) { this.innerHTML += html; },
    closest() { return null; }
  };
  el.parentNode = { appendChild() {}, removeChild() {}, insertBefore() {}, remove() {} };
  el.parentElement = el.parentNode;
  return el;
}

function buildSandbox(log) {
  const elements = new Map();
  const domReady = [];
  const getEl = (id) => {
    if (!elements.has(id)) elements.set(id, makeElement(id));
    return elements.get(id);
  };

  const document = {
    getElementById: (id) => (id ? getEl(id) : null),
    createElement: (tag) => makeElement(),
    createTextNode: (t) => ({ _html: String(t) }),
    querySelectorAll: () => [],
    querySelector: () => makeElement(),
    addEventListener: (ev, fn) => { if (ev === 'DOMContentLoaded') domReady.push(fn); },
    removeEventListener: () => {},
    body: makeElement('body'),
    head: makeElement('head'),
    documentElement: makeElement('html'),
    readyState: 'complete'
  };

  const Chart = function (ctx, cfg) {
    this.ctx = ctx;
    this.config = cfg;
    this.data = (cfg && cfg.data) || {};
    this.options = (cfg && cfg.options) || {};
    this.canvas = ctx;
  };
  Chart.prototype.update = function () {};
  Chart.prototype.destroy = function () {};
  Chart.prototype.resize = function () {};
  Chart.register = function () {};
  Chart.defaults = { font: {}, color: '', plugins: {} };

  const sandbox = {
    document,
    Chart,
    navigator: { userAgent: 'node-runtime-check', language: 'zh-CN' },
    location: { href: 'http://localhost/', search: '', hash: '' },
    localStorage: { getItem: () => null, setItem() {}, removeItem() {} },
    sessionStorage: { getItem: () => null, setItem() {}, removeItem() {} },
    matchMedia: () => ({ matches: false, addListener() {}, addEventListener() {} }),
    requestAnimationFrame: (fn) => (typeof fn === 'function' ? fn() : 0),
    cancelAnimationFrame: () => {},
    setTimeout: () => 0,
    clearTimeout: () => {},
    setInterval: () => 0,
    clearInterval: () => {},
    fetch: () => Promise.resolve({ json: () => Promise.resolve({}) }),
    console: {
      log: (...a) => log.push(a.join(' ')),
      info: (...a) => log.push(a.join(' ')),
      warn: (...a) => log.push('WARN ' + a.join(' ')),
      error: (...a) => log.push('ERROR ' + a.join(' '))
    }
  };
  sandbox.window = sandbox;
  sandbox.self = sandbox;
  sandbox.globalThis = sandbox;
  sandbox.top = sandbox;
  sandbox.__domReady = domReady;
  sandbox.__elements = elements;
  return sandbox;
}

// ---------- 主流程 ----------
let failed = false;

for (const [path, label] of FILES) {
  if (!fs.existsSync(path)) {
    console.log(`${label}: 跳过（文件不存在）`);
    continue;
  }
  const html = fs.readFileSync(path, 'utf8');
  const scripts = [...html.matchAll(/<script[^>]*>([\s\S]*?)<\/script>/g)]
    .map(m => m[1])
    .filter(s => s.trim().length > 0);
  if (scripts.length === 0) {
    console.log(`${label}: 跳过（无 script 块）`);
    continue;
  }

  const log = [];
  const sandbox = buildSandbox(log);
  const ctx = vm.createContext(sandbox);

  // 1) 加载期：脚本顶层执行是否抛错
  let loadErr = null;
  try {
    for (const code of scripts) {
      vm.runInContext(code, ctx, { filename: label });
    }
  } catch (e) {
    loadErr = e;
  }
  if (loadErr) {
    console.log(`${label}: ❌ 脚本加载期异常 → ${loadErr.name}: ${loadErr.message}`);
    failed = true;
    continue;
  }

  // 2) 渲染期：优先走真实入口 selectStore（内部会分派到 renderComparison / renderStore）
  const targets = [];
  if (typeof ctx.selectStore === 'function') {
    targets.push(['selectStore', REGION_TAB]);
    for (const s of STORES) targets.push(['selectStore', s]);
  } else {
    if (typeof ctx.renderComparison === 'function') targets.push(['renderComparison', undefined]);
    if (typeof ctx.renderStore === 'function') {
      targets.push(['renderStore', REGION_TAB]);
      for (const s of STORES) targets.push(['renderStore', s]);
    }
  }

  if (targets.length === 0) {
    console.log(`${label}: ⚠️ 未找到 selectStore / renderComparison / renderStore，无法校验`);
    continue;
  }

  let okCount = 0;
  let fileFailed = false;
  for (const [fn, arg] of targets) {
    const f = ctx[fn];
    if (typeof f !== 'function') continue;
    // 每次渲染前重置 content，避免相互污染
    for (const key of ['content', 'comparison', 'storeContent']) {
      if (sandbox.__elements.has(key)) sandbox.__elements.get(key).innerHTML = '';
    }
    try {
      f(arg);
    } catch (e) {
      const where = `${label}/${fn}(${arg === undefined ? '-' : arg})`;
      console.log(`${where}: ❌ ${e.name}: ${e.message}`);
      if (e.stack) {
        const line = e.stack.split('\n').find(l => l.includes(label));
        if (line && line.trim()) console.log(`    ↳ ${line.trim()}`);
      }
      failed = true;
      fileFailed = true;
      continue;
    }
    const content = sandbox.__elements.get('content') || sandbox.__elements.get('comparison');
    const len = content ? String(content.innerHTML || '').length : 0;
    const tag = `${label}/${fn}(${arg === undefined ? '-' : arg})`;
    if (len < MIN_CONTENT_LEN) {
      console.log(`${tag}: ⚠️ 渲染产物仅 ${len} 字符（阈值 ${MIN_CONTENT_LEN}），疑似空白`);
      failed = true;
      fileFailed = true;
    } else {
      okCount++;
    }
  }

  const errLogs = log.filter(l => l.startsWith('ERROR'));
  for (const l of errLogs.slice(0, 5)) console.log(`${label}: ${l}`);

  if (!fileFailed) {
    console.log(`${label}: ✅ ${okCount} 个渲染入口全部正常`);
  }
}

process.exit(failed ? 1 : 0);
